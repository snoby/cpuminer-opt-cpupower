	uninstall-man uninstall-man1

.PRECIOUS: Makefile


# special CFLAGS (if you find a simpler way to do that tell me ;)
@HAVE_WINDOWS_TRUE@cpuminer-neoscrypt.o: neoscrypt.c
@HAVE_WINDOWS_TRUE@	@echo "CUSTOM ${@}: ${filter %.o,${^}} ${filter %.c,${^}}"
@HAVE_WINDOWS_TRUE@	$(CC) $(common_ccflags) -g -O3 $(gprof_cflags) -MT $@ -MD -MP -c -o $@ $<

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
